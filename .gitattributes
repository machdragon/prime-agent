# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Never text-merge the lockfile. A three-way merge of it produces a plausible
# looking file that describes a tree npm never resolved; regenerating it with
# `npm install` is the only correct resolution. `-merge` makes git take our side
# and report the conflict instead of inventing one.
package-lock.json -merge linguist-generated

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
